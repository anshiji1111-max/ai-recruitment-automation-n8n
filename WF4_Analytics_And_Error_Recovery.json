    {
      "parameters": {
        "sendTo": "={{$('Edit Fields').item.json.email}}",
        "subject": "🎉 Your Offer Letter - Action Required (E-Signature Needed)",
        "message": "=Hello {{$('Edit Fields').item.json.name}},\n\nWe are thrilled to formally offer you the position of {{$('Edit Fields').item.json.position}} at our organization.\n\n📄 OFFER DETAILS:\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPosition: {{$('Edit Fields').item.json.position}}\nSalary: INR {{$('Edit Fields').item.json.salary}} per annum\nJoining Date: {{$('Edit Fields').item.json.joiningDate}}\nDepartment: {{$('Edit Fields').item.json.department}}\nProbation Period: 3 months\nBenefits: Health Insurance, Performance Bonus, Flexible Hours\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n✍️ NEXT STEP:\nPlease review the attached offer letter and sign electronically within 5 business days.\nDocuSign Link: https://docusign.com/offer-{{$('Edit Fields').item.json.candidateId}}\n\nWe look forward to welcoming you to our team!\n\nBest Regards,\nHuman Resources Department",
        "options": {}
      },
