    {
      "parameters": {
        "jsCode": "const content = $json.choices[0].message.content;\n\n// Remove <think>...</think>\nconst cleanContent = content\n  .replace(/<think>[\\s\\S]*?<\\/think>/g, '')\n  .trim();\n\n// Extract JSON if extra text is still present\nconst jsonMatch = cleanContent.match(/\\{[\\s\\S]*\\}/);\n\nif (!jsonMatch) {\n  throw new Error(\"AI response does not contain valid JSON\");\n}\n\nconst response = JSON.parse(jsonMatch[0]);\n\nreturn [{\n  json: {\n    offerId: response.offerId ?? \"OFFER-\" + Date.now(),\n    benefits: response.benefits ?? [],\n    probationPeriod: response.probationPeriod ?? \"3 months\",\n    reportingManager: response.reportingManager ?? \"Department Manager\"\n  }\n}];"
      },
