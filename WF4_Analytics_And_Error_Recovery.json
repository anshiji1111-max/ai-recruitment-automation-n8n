        "jsonBody": "={\n  \"model\": \"qwen/qwen3.6-27b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an HR document expert. Generate formal offer letter content and return ONLY valid JSON with fields: offerId (string), benefits (array), probationPeriod (string), reportingManager (string). Do not include markdown or text outside JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate offer details for: Position={{ $('Edit Fields').item.json.position }}, Salary={{ $('Edit Fields').item.json.salary }}, Department={{ $('Edit Fields').item.json.department }}\"\n    }\n  ],\n  \"response_format\": {\n    \"type\": \"json_object\"\n  }\n}",
